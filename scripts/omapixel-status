#!/usr/bin/env python3
"""The stable interface between the tools underneath and anything we draw.

  scripts/omapixel-status          human-readable
  scripts/omapixel-status --json   the contract, see docs/08-status-contract.md

Consumers read this. They never read pbpctrl, rquickshare or kdeconnect-cli
output directly, so that replacing one of those costs one file here and nothing
anywhere else.

Two promises this file exists to keep:

  * It always emits valid JSON, including on a machine where nothing is
    installed, nothing is paired and nothing is running. That case is the one
    that matters and the one nobody tests.
  * Nothing is ever unavailable without saying why, in two forms: `status` for
    code and `reason` for humans. "No battery showing" has three different
    fixes -- install a package, start a daemon, pair a device -- and a consumer
    must not have to parse English to tell them apart. Every failure found
    during bring-up was silent; these two fields are where that stops.

Standard library only, deliberately: a contributor must be able to run this on a
bare Python. See docs/05-packaging.md.
"""

from __future__ import annotations

import ipaddress
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
from datetime import datetime, timezone

SCHEMA = 1

# Every command that parses output runs under this. A percentile calculation
# has already been silently wrong once on this project because sort -n met a
# comma-decimal locale, and ping prints "tiempo=" instead of "time=" in Spanish.
# See docs/05-packaging.md.
def probe_env() -> dict:
    """The environment to run a probe in. Built per call, never at import.

    This used to be a module-level ENV captured when the module was imported,
    while shutil.which() resolved against os.environ. Two sources of truth for
    "which program is this", and which one won depended on when the module
    happened to be imported. The emulator's test harness had the same pattern
    and its PATH substitution failed to contain anything: which() looked at the
    replaced PATH and Popen ran with the captured one, so a test written to
    publish nothing published a real mDNS record on the LAN.

    This file is worse than a harness, because it runs on the user's machine.
    Both now read os.environ at call time, so they cannot disagree.
    """
    return {**os.environ, "LC_ALL": "C", "LANG": "C"}


def run(cmd: list[str], timeout: int = 5) -> tuple[int, str]:
    """Run a command. Never raises: a failure is data, not an exception."""
    try:
        p = subprocess.run(
            cmd, capture_output=True, text=True, timeout=timeout,
            env=probe_env(), check=False,
        )
        return p.returncode, p.stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return 127, ""


# Why a capability is not available, structurally. "No battery showing" has
# three completely different fixes — install a package, start a daemon, pair a
# device — and a consumer must not have to parse English prose to tell them
# apart. The reason string is for humans; this field is for code.
NOT_INSTALLED = "not_installed"    # the tool is not on this machine
NO_ANSWER = "no_answer"            # installed, but it did not respond
NOTHING_PRESENT = "nothing_present"  # it answered, and there is no device
NOT_PROBED = "not_probed"          # deliberately not asked, see reason
# Installed, startable, and starting it damages this machine. Distinct from
# no_answer because the two carry opposite advice: no_answer means "start it",
# and a consumer that switches on status — as this contract tells it to — will
# say exactly that. On BlueZ 5.87 that advice crashes bluetoothd and takes the
# user's Bluetooth mouse with it, so the missing state was not cosmetic: the
# bar was about to give actively harmful advice, correctly derived from a
# vocabulary that had no way to say anything else. Raised by the desktop layer
# on 2026-08-16. Named to match `blocked` in the capability matrix.
BLOCKED = "blocked"
# Known and paired, and not answering right now. Added 2026-08-17 because the
# contract was contradicting itself: this case reported nothing_present, whose
# documented meaning is "it answered and there is no device", while reason,
# state.devices and actions all correctly said there was one. Three of the four
# fields agreed and the one that disagreed was the authoritative one.
#
# That is worse than a wrong label. The contract's own rule is "switch on
# status, never on the prose", so a consumer doing exactly what it is told
# would tell the user to pair a phone that is already paired, while the correct
# reason went past unread. The field nobody is allowed to trust was right and
# the field everybody must trust was wrong.
#
# It is also the same distinction that got separated two days ago coming back
# through another door: paired-but-out-of-range collapsed into nothing-paired.
# It was fixed in `state` with `reachable`, and reappeared in `status`. Reusing
# an existing value would have hidden it a third time — no_answer is about the
# daemon, and the daemon answered. Raised by the desktop layer.
UNREACHABLE = "unreachable"
READY = "ready"


def unavailable(reason: str) -> dict:
    """The shape for "there is no value here, and this is why".

    Used for anything a consumer might otherwise render as an empty slot.
    Battery adds `source` on top; ANC does not, because there is no equivalent
    "which protocol answered" distinction to make.
    """
    return {"kind": "unavailable", "reason": reason}


def battery_unavailable(reason: str) -> dict:
    return {"kind": "unavailable", "reason": reason, "source": None}


# The fourth primitive: an available action.
#
# Requested by the desktop layer before either side wrote it. At least three are
# coming — retry the link, cycle ANC, send a file — and as separate fields they
# would become can_retry, anc_settable and send_available, with the fourth case
# argued from scratch. Provenance already taught that lesson three times.
#
# Absent means there is nothing to do. It never means there is something and we
# are not saying.
ACTIONS = ("retry-link", "cycle-anc", "send-file")


def action(action_id: str, label: str, available: bool, reason=None) -> dict:
    assert action_id in ACTIONS, f"unknown action id {action_id!r}"
    out = {"id": action_id, "label": label, "available": available}
    if not available:
        out["reason"] = reason
    return out


def capability(status: str, reason: str | None, provider, state: dict,
               actions: list | None = None) -> dict:
    # as_of is stamped per capability, not per document, because a consumer
    # that caches caches one answer at a time. Without it a value from a second
    # ago and a value from a minute ago render identically, and the bar shows a
    # stale battery figure with the confidence of a fresh one. The value is the
    # moment this capability was probed, never the moment it was rendered.
    return {
        "available": status == READY,
        "status": status,
        "reason": reason,
        "provider": provider,
        # Milliseconds, not seconds. The whole call takes 84 ms, so two
        # consecutive probes would otherwise carry an identical stamp and a
        # consumer comparing them could not tell a fresh answer from one 999 ms
        # old — the same argument that put the stamp here, one level down.
        "as_of": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%f")[:-3] + "Z",
        "state": state,
        **({"actions": actions} if actions else {}),
    }


def pkg_version(name: str) -> str | None:
    rc, out = run(["pacman", "-Q", name])
    return out if rc == 0 and out else None


# --- host -------------------------------------------------------------------


def probe_host() -> dict:
    distro = "unknown"
    rc, out = run(["sh", "-c", ". /etc/os-release && echo ${PRETTY_NAME:-$NAME}"])
    if rc == 0 and out:
        distro = out
    # Only qualifies a distro we actually identified: "unknown 4.0.0.alpha"
    # reads like a version of nothing.
    if distro != "unknown":
        try:
            version = open(
                os.path.expanduser("~/.local/share/omarchy/version")
            ).read().strip()
            if version:
                distro = f"{distro} {version}"
        except OSError:
            pass

    desktop = os.environ.get("XDG_CURRENT_DESKTOP", "unknown")
    rc, out = run(["hyprctl", "version"])
    if rc == 0 and out:
        desktop = " ".join(out.splitlines()[0].split()[:2])

    # Subnet, never the host address: this output gets pasted into issues.
    subnet = None
    rc, out = run(["ip", "-4", "-o", "addr", "show", "scope", "global"])
    if rc == 0:
        for line in out.splitlines():
            fields = line.split()
            if len(fields) < 4:
                continue
            iface = fields[1]
            if iface.startswith(("docker", "br-", "virbr", "veth", "tailscale")):
                continue
            # ip_network rather than zeroing the last octet: a /16 zeroed at
            # the fourth octet yields 10.1.2.0/16, which is not that network.
            try:
                subnet = str(ipaddress.ip_network(fields[3], strict=False))
            except ValueError:
                continue
            break

    return {"distro": distro, "desktop": desktop, "subnet": subnet}


# --- capabilities -----------------------------------------------------------


# BlueZ up to and including 5.87 crashes when a client registers a UUID
# discovery filter and any neighbour advertises a service: is_filter_match()
# hands queue_find() its arguments swapped, so a UUID string gets called as a
# function. Measured from three core dumps on this machine on 2026-08-16; the
# backtrace is in docs/04-reference-setup.md. Fixed upstream in 82af2be, six
# days after the 5.87 tag, and no release carries it yet.
#
# Version-gated rather than hardcoded, because "rquickshare is dangerous" is
# false on 5.88 and this file would otherwise keep saying it forever.
BLUEZ_FIRST_SAFE = (5, 88)


def bluez_version() -> tuple[int, ...] | None:
    """(major, minor) or None when it cannot be determined.

    Asks BlueZ, not the package manager. `pkg_version` shells out to pacman,
    and docs/05-packaging.md says the product cannot assume a distribution —
    on anything without pacman this would have returned None forever, and
    since unknown is treated as unsafe, the capability would have been blocked
    permanently on every non-Arch machine. `bluetoothctl --version` prints and
    exits without touching the adapter.
    """
    rc, out = run(["bluetoothctl", "--version"])
    if rc != 0 or not out:
        out = pkg_version("bluez") or ""
    match = re.search(r"(\d+)\.(\d+)", out)
    return (int(match[1]), int(match[2])) if match else None


def running_daemon_predates_binary() -> bool | None:
    """True when bluetoothd started before the binary on disk was last written.

    The version above is the binary's, and the binary is the name — the daemon
    in memory is the thing. The scenario is not exotic, it is the one that will
    happen: 5.88 ships, the user upgrades, nothing restarts bluetoothd, and the
    live process is still the 5.87 that crashes while the version check says
    safe. The bar would then advise exactly the action that kills the mouse.

    Comparing start time against the binary's mtime is the cheap approximation.
    None when it cannot be determined, which the caller treats as unsafe.
    """
    rc, out = run(["pgrep", "-x", "bluetoothd"])
    if rc != 0 or not out.strip():
        return None
    pid = out.split()[0]
    for path in ("/usr/lib/bluetooth/bluetoothd", "/usr/libexec/bluetooth/bluetoothd"):
        try:
            # /proc/<pid> is created when the process starts, so its mtime is
            # the daemon's start time without needing to read /proc/<pid>/exe,
            # which is root-only for a root-owned process.
            return os.stat(f"/proc/{pid}").st_mtime < os.stat(path).st_mtime
        except OSError:
            continue
    return None


def le_discovery_is_safe() -> tuple[bool, str]:
    """(safe, what we actually know). Never claims a cause it did not check."""
    version = bluez_version()
    if version is None:
        # Unknown is not safe: the point of this state is to stop a consumer
        # advising an action that breaks the machine, and "we could not tell"
        # is not grounds to advise it. But the reason must say that, not
        # assert a defect in a version nobody read — on a machine without
        # pacman and without bluetoothctl, claiming "the installed bluez
        # crashes bluetoothd" is simply false.
        return False, "the version of bluez could not be determined"

    found = ".".join(str(n) for n in version)
    if version < BLUEZ_FIRST_SAFE:
        return False, f"bluez {found} has the bug"

    stale = running_daemon_predates_binary()
    if stale is None:
        return False, (
            f"bluez {found} on disk has the fix, but whether the running "
            f"bluetoothd is that build could not be determined"
        )
    if stale:
        return False, (
            f"bluez {found} on disk has the fix, but bluetoothd started before "
            f"that build was installed and is still the old one — restart it"
        )
    return True, f"bluez {found}"


def probe_file_transfer() -> dict:
    if not shutil.which("rquickshare"):
        return capability(
            NOT_INSTALLED, "rquickshare is not installed", None,
            {"running": False, "peers": unavailable("rquickshare is not running")},
        )

    provider = pkg_version("r-quick-share") or "rquickshare"

    safe, known = le_discovery_is_safe()
    if not safe:
        return capability(
            BLOCKED,
            f"do not start rquickshare on this machine: {known}. BlueZ up to "
            f"5.87 crashes when a discovery filter meets an advertisement, and "
            f"that takes any Bluetooth mouse down with it. Fixed upstream in "
            f"82af2be, unreleased — waiting for bluez 5.88",
            provider,
            {
                "running": False,
                "peers": unavailable("discovery would crash bluetoothd"),
                "blocked_by": known,
                "unblocked_by": "bluez 5.88, and a bluetoothd restarted into it",
            },
        )

    if run(["pgrep", "-x", "rquickshare"])[0] != 0:
        return capability(
            NO_ANSWER, "rquickshare is installed but not running", provider,
            {"running": False, "peers": unavailable("rquickshare is not running")},
        )

    # A running process is not the same as a working one. Check the observable
    # effect — a listening socket — rather than trusting that the process being
    # alive means it is serving. This machine has produced four separate
    # subsystems tonight that reported confidently and wrongly about
    # themselves; see the doctor rule in docs/07-plan.md.
    rc, sockets = run(["ss", "-ltnHp"])
    if rc != 0:
        return capability(
            NO_ANSWER, "rquickshare is running but its socket could not be checked",
            provider,
            {"running": True, "peers": unavailable("socket state unknown")},
        )
    if "rquickshare" not in sockets:
        # "ss showed no process names at all" and "ss showed names and none is
        # ours" are different facts. ss -p only attributes sockets it can — a
        # flatpak, another user or a namespace hides the name — so collapsing
        # them would report "not listening" for a peer that is listening fine.
        # Same mistake QA caught in the earbuds path, wearing a different skin.
        if "users:((" not in sockets:
            return capability(
                NO_ANSWER,
                "rquickshare is running but no socket could be attributed to "
                "any process, so whether it is listening is unknown",
                provider,
                {"running": True, "peers": unavailable("socket ownership unknown")},
            )
        return capability(
            NO_ANSWER,
            "rquickshare is running but is not listening for transfers",
            provider,
            {"running": True, "peers": unavailable("not listening")},
        )

    # Deliberately not reporting the listening port. It is chosen afresh on
    # every launch (measured: 35475, then 34261 after a restart), so it is not
    # a stable fact about the machine and a consumer must not cache it.
    #
    # peers is unavailable rather than [], because an empty list reads as
    # "we looked and nobody is there" — which is exactly the wrong thing to
    # show next to status: ready.
    return capability(
        READY, None, provider,
        {
            "running": True,
            "peers": unavailable("peer discovery is not implemented yet (B1)"),
        },
    )


# KDE Connect is asked over D-Bus, not through kdeconnect-cli.
#
# Measured on the reference machine on 2026-08-16, five runs, variance under
# 5 ms: the whole status call took 2090 ms and 2008 ms of that was one command,
# `kdeconnect-cli --list-devices`. That is not the daemon being slow — the CLI
# runs a two-second discovery cycle before it answers, a fixed wait. The same
# question over D-Bus answers in 2 ms.
#
# It matters because of who consumes this. A bar widget refreshing once a
# second cannot hold a process open for two of them. The alternative on the
# table was caching the answer, which hides the wait instead of removing it and
# then needs a freshness stamp to stay honest.
#
# D-Bus also answers more precisely than the CLI did: `devices` takes
# onlyReachable and onlyPaired, so "paired but out of range" stops being
# indistinguishable from "nothing paired" — a distinction the CLI could not
# make and that has two different fixes for the user.
KDECONNECT_BUS = "org.kde.kdeconnect"
KDECONNECT_PATH = "/modules/kdeconnect"
KDECONNECT_IFACE = "org.kde.kdeconnect.daemon"


def kdeconnect_devices(only_reachable: bool) -> tuple[bool, list[str]]:
    """Returns (answered, device ids). Never raises."""
    rc, out = run([
        "busctl", "--user", "call", KDECONNECT_BUS, KDECONNECT_PATH,
        KDECONNECT_IFACE, "devices", "bb",
        "true" if only_reachable else "false", "true",
    ])
    if rc != 0:
        return False, []
    # busctl prints an array as: as 2 "id-one" "id-two"
    parts = shlex.split(out)
    if len(parts) < 2 or parts[0] != "as":
        return False, []
    return True, parts[2:]


def probe_phone_link() -> dict:
    if not shutil.which("kdeconnectd"):
        return capability(
            NOT_INSTALLED, "kdeconnect is not installed", None,
            {"devices": [], "reachable": []},
        )

    # busctl is systemd's, and docs/05-packaging.md says the product cannot
    # assume systemd. On a machine without it but with KDE Connect running,
    # what is missing is our way of asking, not their package — and the two
    # have different fixes. Saying "kdeconnect is not installed" there would be
    # a plain lie about someone else's machine.
    if not shutil.which("busctl"):
        return capability(
            NOT_PROBED,
            "kdeconnect is installed, but busctl is not available to query it "
            "on this machine — this is our missing query path, not a missing "
            "kdeconnect",
            pkg_version("kdeconnect") or "kdeconnect",
            {"devices": [], "reachable": []},
        )

    provider = pkg_version("kdeconnect") or "kdeconnect"
    answered, paired = kdeconnect_devices(only_reachable=False)
    if not answered:
        return capability(
            NO_ANSWER, "kdeconnect is installed but its daemon did not answer",
            provider, {"devices": [], "reachable": []},
        )

    if not paired:
        return capability(
            NOTHING_PRESENT, "no device is paired with KDE Connect", provider,
            {"devices": [], "reachable": []},
        )

    # The `answered` flag is not discardable here. If the daemon dies between
    # the two calls, an empty list would otherwise be reported as "paired but
    # out of range — the phone is off", which is a specific invented cause for
    # a reading that was never taken. Same defect QA found in probe_buds with
    # bluetoothd down. Nobody answered means no_answer, whatever the shape of
    # the empty value that came back.
    answered, reachable = kdeconnect_devices(only_reachable=True)
    if not answered:
        return capability(
            NO_ANSWER,
            "kdeconnect answered which devices are paired, then stopped "
            "answering — whether any is reachable is unknown, not negative",
            provider, {"devices": paired, "reachable": []},
        )

    if not reachable:
        # The measured case from 2026-08-17: paired, the phone answering pings,
        # and KDE Connect simply not reconnecting. The user sees "disconnected"
        # over a working network. There is something to do about it, so say so.
        return capability(
            UNREACHABLE,
            f"{len(paired)} device(s) paired with KDE Connect, none reachable "
            f"right now — the phone is off, asleep, on another network, or the "
            f"link dropped and did not come back on its own",
            provider, {"devices": paired, "reachable": []},
            actions=[action("retry-link", "Reconnect", True)],
        )
    return capability(
        READY, None, provider, {"devices": paired, "reachable": reachable}
    )


def probe_buds(probe_bluetooth: bool) -> dict:
    """Earbuds battery and ANC.

    Does NOT talk to the earbuds unless explicitly asked. On the reference
    machine, a tool bringing up a BLE listener segfaults bluetoothd and takes
    the user's Bluetooth mouse down with it — reproduced three times out of
    three on 2026-08-15. Until B0 settles whether that is rquickshare-specific
    or lives in BlueZ, a status command must not be the thing that crashes
    somebody's desktop. Reading the pairing list is safe; talking is not.
    """

    def out(status: str, reason: str, provider) -> dict:
        return capability(
            status, reason, provider,
            {
                "battery": battery_unavailable(reason),
                "anc": unavailable(reason),
            },
        )

    if not shutil.which("pbpctrl"):
        return out(NOT_INSTALLED, "pbpctrl is not installed", None)

    provider = pkg_version("pbpctrl") or "pbpctrl"

    if not shutil.which("bluetoothctl"):
        return out(NOT_INSTALLED, "bluetoothctl is not installed", provider)

    # A failure here must NOT be reported as "nothing is paired". On this
    # machine bluetoothd segfaults, and when it is down bluetoothctl exits
    # non-zero with an empty list — which would tell the user to pair a device
    # when what they actually need is to start a daemon. Collapsing those two
    # is precisely what this contract exists to prevent.
    rc, listing = run(["bluetoothctl", "devices", "Paired"])
    if rc != 0:
        return out(
            NO_ANSWER,
            "the bluetooth daemon did not answer, so what is paired is unknown",
            provider,
        )

    # Matches "buds" only. Matching "pixel" too would count the phone as
    # earbuds the moment it is paired over Bluetooth, which F2 will do shortly.
    paired = [line for line in listing.splitlines() if "buds" in line.lower()]

    if not paired:
        return out(NOTHING_PRESENT, "no earbuds paired with this adapter", provider)

    if not probe_bluetooth:
        return out(
            NOT_PROBED,
            "earbuds paired but not queried: talking to them over BLE can "
            "crash bluetoothd on this machine. Pass --probe-bluetooth to try",
            provider,
        )

    return out(NOT_PROBED, "querying the earbuds is not implemented yet (B1)", provider)


def build(probe_bluetooth: bool) -> dict:
    return {
        "schema": SCHEMA,
        "generated": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "host": probe_host(),
        "capabilities": {
            "file-transfer": probe_file_transfer(),
            "phone-link": probe_phone_link(),
            "buds": probe_buds(probe_bluetooth),
        },
    }


# --- output -----------------------------------------------------------------


def render(data: dict) -> str:
    lines = [f"host    {data['host']['distro']}, {data['host']['desktop']}"]
    subnet = data["host"]["subnet"]
    lines.append(f"subnet  {subnet if subnet else 'none'}")
    lines.append("")

    for name, cap in data["capabilities"].items():
        mark = "+" if cap["available"] else "-"
        lines.append(f"  {mark} {name}")
        if cap["provider"]:
            lines.append(f"      via {cap['provider']}")
        if cap["reason"]:
            lines.append(f"      {cap['reason']}")

        battery = cap["state"].get("battery")
        if battery and battery["kind"] == "per_bud":
            parts = [
                f"{k} {battery[k]}%" for k in ("left", "right", "case")
                if battery.get(k) is not None
            ]
            lines.append(f"      battery {', '.join(parts)}")
        elif battery and battery["kind"] == "combined":
            lines.append(f"      battery {battery['combined']}% (combined)")
    return "\n".join(lines)


def main(argv: list[str]) -> int:
    args = argv[1:]
    if "--help" in args or "-h" in args:
        print(__doc__.strip())
        return 0

    known = {"--json", "--probe-bluetooth"}
    unknown = [a for a in args if a not in known]
    if unknown:
        # Not ignored silently: "--jsonn" quietly printing human output is the
        # kind of thing that wastes an afternoon in a script somewhere.
        print(f"unknown option: {unknown[0]} (try --help)", file=sys.stderr)
        return 2

    as_json = "--json" in args
    probe_bluetooth = "--probe-bluetooth" in args

    # Rendering is inside the try as well as building. The promise is that this
    # command always produces parseable output, and a provider returning an
    # unexpected shape must not turn into a traceback on the human path.
    try:
        data = build(probe_bluetooth)
        print(json.dumps(data, indent=2) if as_json else render(data))
        return 0
    except Exception as exc:  # noqa: BLE001 - a status command must never die
        # Even the failure is valid JSON carrying `error`, so a consumer can
        # always parse. The exit code is what says the command itself broke.
        print(
            json.dumps(
                {
                    "schema": SCHEMA,
                    "generated": datetime.now(timezone.utc).strftime(
                        "%Y-%m-%dT%H:%M:%SZ"
                    ),
                    "host": {},
                    "capabilities": {},
                    "error": f"{type(exc).__name__}: {exc}",
                },
                indent=2,
            )
        )
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
